{
  "name": "arakmar-etckeeper",
  "version": "3.0.0",
  "author": "Yoann Laissus",
  "summary": "Keeps /etc under version control with etckeeper",
  "license": "Apache-2.0",
  "source": "https://github.com/Arakmar/puppet-etckeeper",
  "project_page": "https://github.com/Arakmar/puppet-etckeeper",
  "issues_url": "https://github.com/Arakmar/puppet-etckeeper/issues",
  "dependencies": [
    {
      "name": "puppetlabs/stdlib",
      "version_requirement": ">= 9.0.0 < 11.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "RedHat",
      "operatingsystemrelease": [
        "8",
        "9",
        "10"
      ]
    },
    {
      "operatingsystem": "CentOS",
      "operatingsystemrelease": [
        "9",
        "10"
      ]
    },
    {
      "operatingsystem": "Rocky",
      "operatingsystemrelease": [
        "8",
        "9",
        "10"
      ]
    },
    {
      "operatingsystem": "AlmaLinux",
      "operatingsystemrelease": [
        "8",
        "9",
        "10"
      ]
    },
    {
      "operatingsystem": "Debian",
      "operatingsystemrelease": [
        "12",
        "13"
      ]
    },
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": [
        "22.04",
        "24.04"
      ]
    },
    {
      "operatingsystem": "Archlinux"
    }
  ],
  "requirements": [
    {
      "name": "openvox",
      "version_requirement": ">= 8.0.0 < 10.0.0"
    }
  ],
  "tags": [
    "etckeeper",
    "git",
    "vcs",
    "etc"
  ]
}
